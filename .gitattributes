# .gitattributes — Normalize line endings for cross-platform compatibility

# Default: auto-detect and normalize
* text=auto

# Web files — always LF in repo, auto-convert on checkout
*.php        text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.js         text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.xml        text eol=lf
*.svg        text eol=lf
*.htaccess   text eol=lf
*.env        text eol=lf

# Binary files — never modify
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary
*.zip    binary
